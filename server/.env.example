PORT=4000
FRONT_URL=http://localhost:5173

# --- Persistent database (required for real data) ---
# Example Atlas URI: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/demo?retryWrites=true&w=majority
# When set, every registration is saved to Mongo (LoginEvent collection).
# When empty, an ephemeral in-memory MongoDB is used (data lost on restart).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/demo?retryWrites=true&w=majority

# --- Gmail sending via Nodemailer (service: gmail) ---
# GMAIL_USER: full Gmail address used to log in and send
# GMAIL_APP_PASSWORD: 16-char App password (NOT your normal login password).
#   Create it at: Google Account -> Security -> 2-Step Verification -> App passwords.
#   Spaces are stripped automatically, so "udqj kife dsrw etww" works as-is.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=paste-your-16-char-app-password-here
# MAIL_FROM_NAME: display name shown in the inbox, e.g. "My Demo App"
MAIL_FROM_NAME=My Demo App
# Optional overrides / extras:
# MAIL_FROM=you@gmail.com
# ADMIN_EMAIL=admin@example.com
# Controlled TLS test only (defaults: 465 / true). For a STARTTLS test set:
# GMAIL_PORT=587
# GMAIL_SECURE=false

# --- Generic SMTP alternative (used only if GMAIL_* is empty) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
